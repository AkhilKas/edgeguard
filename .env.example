# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEPLOYMENT_CONTEXT=home_assistant   # home_assistant | security_log | iot_controller

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_MODEL_PATH=models/qwen3.5-0.8b-q4_k_m.gguf
LLM_CONTEXT_WINDOW=2048
LLM_MAX_TOKENS=128
LLM_N_THREADS=4
LLM_TEMPERATURE=0.7
LLM_REPEAT_PENALTY=1.3
LLM_SYSTEM_PROMPT=You are EdgeGuard, a concise assistant for a smart home device. Respond in one short sentence.

# ── Guardrail ─────────────────────────────────────────────────────────────────
GUARDRAIL_MODE=heuristic            # heuristic | ml (switch to ml in Week 4)
# Path to distilled classifier (required when GUARDRAIL_MODE=ml)
GUARDRAIL_MODEL_PATH=
GUARDRAIL_CONFIDENCE_THRESHOLD=0.75
GUARDRAIL_ENABLED=true

# ── MCU ───────────────────────────────────────────────────────────────────────
# Arduino Router Bridge address (unix://<path> or tcp://<host>:<port>)
MCU_ADDRESS=unix:///var/run/arduino-router.sock
MCU_TIMEOUT=5.0
MCU_ENABLED=true                    # set false in CI or dev without hardware

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
