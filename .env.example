# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEPLOYMENT_CONTEXT=home_assistant   # home_assistant | security_log | iot_controller

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_MODEL_PATH=models/lfm2.5-350m-q4_k_m.gguf
LLM_CONTEXT_WINDOW=2048
LLM_MAX_TOKENS=128
LLM_N_THREADS=4
LLM_TEMPERATURE=0.7
LLM_REPEAT_PENALTY=1.3
# Leave blank to use the default system prompt defined in config/settings.py
# (it spans multiple lines, so isn't practical to express as a single .env
# value — set this only if you want to override it entirely).
LLM_SYSTEM_PROMPT=

# ── Guardrail ─────────────────────────────────────────────────────────────────
GUARDRAIL_MODE=heuristic            # heuristic | ml
# Path to the ONNX-exported classifier + its tokenizer.json (both required
# when GUARDRAIL_MODE=ml; see src/edgeguard/training/edge_guard_training.ipynb)
GUARDRAIL_MODEL_PATH=
GUARDRAIL_TOKENIZER_PATH=
GUARDRAIL_CONFIDENCE_THRESHOLD=0.75
GUARDRAIL_ENABLED=true

# ── MCU ───────────────────────────────────────────────────────────────────────
# Arduino Router Bridge address (unix://<path> or tcp://<host>:<port>)
MCU_ADDRESS=unix:///var/run/arduino-router.sock
MCU_TIMEOUT=5.0
MCU_ENABLED=true                    # set false in CI or dev without hardware

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Actions ───────────────────────────────────────────────────────────────────
ACTIONS_PHOTO_DIR=/home/arduino/photos
ACTIONS_CAMERA_WARMUP_SECONDS=1.5   # keep USB cam streaming so Brio LED/AE settle
ACTIONS_CAMERA_DISCARD_FRAMES=8

# ── Speech-to-text (optional Whisper via faster-whisper) ──────────────────────
# Requires: pip install -e ".[stt]", ffmpeg, and for /voice/device: alsa-utils
# Prefer dashboard "Listen on device" (POST /voice/device) over browser mic —
# that records on the board and works over plain http://board-ip:8000/.
STT_ENABLED=false
STT_MODEL_SIZE=tiny                 # tiny | base | small — tiny is best on UNO Q
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en                     # empty = auto-detect
STT_RECORD_SECONDS=4                # board mic listen duration
STT_ALSA_DEVICE=auto                # auto | plughw:1,0 | plug:default (not plain default)
STT_SAMPLE_RATE=16000
